# Le filtre 'redact' masque les valeurs sensibles au commit (clean)
# et les restaure dans l'arbre de travail (smudge).
# Voir tools/install-filters.sh et guidelines.md, section « Le masquage ».
*.md filter=redact
*.sh filter=redact
*.yaml filter=redact
*.yml filter=redact
*.rules filter=redact
*.example filter=redact
*.py filter=redact
Dockerfile* filter=redact
LICENSE filter=redact
.gitignore filter=redact
.dockerignore filter=redact
.githooks/* filter=redact
