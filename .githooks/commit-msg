#!/bin/sh
# Filet de securite : refuse un message de commit qui contient une valeur
# sensible, un jeton ecrit en prose sans backticks, ou l'adresse publique
# actuelle en clair.
root=$(git rev-parse --show-toplevel)
python3 "$root/tools/check_leaks.py" --commit-msg "$1"
code=$?
[ "$code" = 0 ] || exit "$code"
exec python3 "$root/tools/wan_ip.py" check --text "$1"